# Cloudflare (see: https://dash.cloudflare.com/profile/api-tokens)
# Required permissions: Account: Cloudflare Tunnel (Edit), Zone: DNS (Edit)
# Add Zone: Firewall Services (Write) when using API_KEY (edge WAF auth rule).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
TUNNEL_NAME=llm-tunnel

# API key — clients use Authorization: Bearer <key> (standard OpenAI format).
# Enforced at the Cloudflare edge for any ingress hostname opted in with
# "auth": { "apiKey": true } in tunnel-config.json. Also passed to llama-server
# (--api-key) as defense-in-depth for LAN access that bypasses the tunnel.
API_KEY=sk-change-me

# ── Backend selection ──────────────────────────────────────────────────────
# Which backend to run: "ollama" or "llama" (only one runs at a time).
# Plain `docker compose up` uses this; override with `docker compose --profile llama up`.
COMPOSE_PROFILES=ollama

# Test script: the public tunnel hostname (must match tunnel-config.json).
OLLAMA_HOSTNAME=llm.example.com

# ── Ollama backend (profile: ollama) ───────────────────────────────────────
OLLAMA_MODEL=tinyllama
# Where ollama stores its own model blobs (NOT the HF cache — different format).
OLLAMA_DATA=.ollama-data

# ── llama.cpp backend (profile: llama) ─────────────────────────────────────
# Shared Hugging Face cache — bind-mounted into model-init + llama as /hf so
# multi-GB downloads dedup with ComfyUI and other HF tools. Defaults to the
# standard cache. NOTE: .env does NOT expand ~, so use an absolute path here.
HF_HOME=${HOME}/.cache/huggingface

# llama-server settings: every option has an LLAMA_ARG_* variable (llama.cpp tools/server/README.md).
# Model to fetch (default = Qwen3.6-27B VL, fits a 16 GB GPU at IQ4_XS). Its mmproj is fetched too.
# Swap to the faster MoE option for a constrained card:
#   LLAMA_ARG_HF_REPO=unsloth/Qwen3-VL-30B-A3B-Instruct-GGUF
#   LLAMA_ARG_HF_FILE=Qwen3-VL-30B-A3B-Instruct-IQ4_XS.gguf
# For a text-only model, set LLAMA_ARG_MMPROJ_AUTO=false.
LLAMA_ARG_HF_REPO=unsloth/Qwen3.6-27B-GGUF
LLAMA_ARG_HF_FILE=Qwen3.6-27B-IQ4_XS.gguf
LLAMA_ARG_MMPROJ_AUTO=true

# GPU layers to offload and context size. Tune the layers down on OOM.
LLAMA_ARG_N_GPU_LAYERS=48
LLAMA_ARG_CTX_SIZE=16384
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0

# Host port for the llama backend; change it when something else (e.g. a host ollama) holds 11434.
LLAMA_HOST_PORT=11434
